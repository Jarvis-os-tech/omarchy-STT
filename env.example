# ==============================================================================
# Linux Voice Dictation (omarchy-dictate) Environment Configuration
# ==============================================================================

# Groq API Key (Recommended: Ultra-fast Whisper STT & instant LLM polishing)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative / Fallback STT & polishing provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Provider ("groq" or "gemini"). Defaults to auto-detect.
# OMARCHY_DICTATE_PROVIDER=groq

# Optional Model Overrides:
# OMARCHY_DICTATE_LIVE_MODEL=whisper-large-v3-turbo
# OMARCHY_DICTATE_POLISH_MODEL=openai/gpt-oss-20b

# Optional: Enable/disable text polishing (1 or 0)
# OMARCHY_DICTATE_POLISH=1
